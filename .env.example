# Production template: copy to .env, replace every empty value, and chmod 600 .env.
# Generate the two secrets with openssl as documented in README.md. Never commit .env.
KOTAK_TERMINAL_ENVIRONMENT=production
KOTAK_TERMINAL_ACCESS_PASSWORD=
KOTAK_TERMINAL_SESSION_SECRET=
KOTAK_TERMINAL_COOKIE_SECURE=true
# Exact JSON array; no wildcard, path, trailing slash, or localhost origin in production.
KOTAK_TERMINAL_CORS_ORIGINS=["https://trade.example.com"]

# Kotak API environment is independent of the app environment. Paper mode remains default.
KOTAK_TERMINAL_KOTAK_ENVIRONMENT=prod
KOTAK_TERMINAL_DEFAULT_MODE=paper
# Reserved VPS static IPv4 used for Kotak Neo static-IP whitelisting.
KOTAK_TERMINAL_PUBLIC_STATIC_IP=
KOTAK_TERMINAL_TICK_INTERVAL_MS=750
KOTAK_TERMINAL_PNL_CHECK_INTERVAL_MS=1000
KOTAK_TERMINAL_SESSION_TTL_SECONDS=43200
KOTAK_TERMINAL_LOGIN_RATE_LIMIT=5
KOTAK_TERMINAL_LOGIN_RATE_WINDOW_SECONDS=60
KOTAK_TERMINAL_LOG_LEVEL=INFO
